#!/usr/bin/env bash
set -euo pipefail

# Pre-commit hook: CHECKS only (no auto-fix / no auto-format)
# Install once per clone:
#   git config core.hooksPath .githooks

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "🔍 pre-commit: lint (no-fix, fail on warnings)"

# Lint must fail on warnings. Enforced via package.json: eslint --max-warnings 0
npm run -s lint

echo "🔍 pre-commit: typecheck"
npm run -s typecheck

echo "✅ pre-commit checks passed"
