{
  "name": "@smartergpt/lexsona",
  "version": "1.1.0",
  "description": "Behavioral memory and persona engine for AI agents. Requires Lex for storage.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "lexsona": "./dist/cli/lexsona.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./rules": {
      "import": "./dist/rules/index.js",
      "types": "./dist/rules/index.d.ts"
    },
    "./persona": {
      "import": "./dist/persona/index.js",
      "types": "./dist/persona/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && npm run copy-assets",
    "copy-assets": "mkdir -p dist/baseline && cp src/baseline/*.yaml dist/baseline/",
    "postbuild": "chmod +x dist/cli/lexsona.js",
    "clean": "rm -rf dist",
    "dev": "tsc -b tsconfig.build.json --watch",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci:minimal": "npm run lint && npm run typecheck",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build",
    "ci:full": "npm run lint && npm run typecheck && npm test && npm run build",
    "local-ci": "npm run ci",
    "prepare": "husky"
  },
  "keywords": [
    "ai",
    "agents",
    "persona",
    "behavioral-memory",
    "lex",
    "constraints"
  ],
  "author": "Guff",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guffawaffle/lexsona.git"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "personas"
  ],
  "peerDependencies": {
    "@smartergpt/lex": ">=2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@smartergpt/lex": ">=2.1.0",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^25.0.2",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.0.15",
    "zod": "^4.1.13"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3",
    "better-sqlite3-multiple-ciphers": "^12.6.2",
    "commander": "^14.0.2",
    "micromatch": "^4.0.8",
    "yaml": "^2.3.0",
    "zod": "^4.1.13"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --check"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --check"
    ]
  }
}
